generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_SEKOLAH
  ADMIN
  GURU
  WALI_KELAS
}

model Sekolah {
  id            String   @id @default(uuid())
  npsn          String   @unique
  nama          String
  alamat        String?
  kepalaSekolah String?
  nipKepsek     String?
  status        String   @default("AKTIF") // AKTIF / NONAKTIF
  isStatus      Boolean  @default(true) // true = 1 (Aktif), false = 0 (Nonaktif / Soft Deleted)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  kelas         Kelas[]
  periodeAkademik PeriodeAkademik[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(GURU)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant sekolah
  sekolahId String?
  sekolah   Sekolah? @relation(fields: [sekolahId], references: [id])

  // Relasi jika user adalah wali kelas
  kelasWali Kelas?

  // Relasi guru pengampu mata pelajaran
  pengampu           Pengampu[]
  tujuanPembelajaran TujuanPembelajaran[]
}

model Kelas {
  id          String   @id @default(uuid())
  nama        String   @unique // Contoh: "7A", "8B"
  tingkat     Int      // Contoh: 7, 8, 9
  tahunAjaran String   // Contoh: "2025/2026"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Tenant sekolah
  sekolahId   String?
  sekolah     Sekolah? @relation(fields: [sekolahId], references: [id])

  // Wali kelas
  waliKelasId String?  @unique
  waliKelas   User?    @relation(fields: [waliKelasId], references: [id])

  siswa       Siswa[]
  pengampu    Pengampu[]
  templates   TemplateRapor[]
}

model Siswa {
  id           String   @id @default(uuid())
  nisn         String   @unique
  nis          String   @unique
  nama         String
  jenisKelamin String   // "L" / "P"
  nik          String?  // NIK Kependudukan (16 digit)
  tempatLahir  String?  // Kota/Kabupaten tempat lahir
  tanggalLahir String?  // Format tanggal lahir (misal: "30/03/2015" atau "2015-03-30")
  agama        String?  // Agama (misal: "Islam", "Kristen", dll)
  alamat       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kelasId String
  kelas   Kelas   @relation(fields: [kelasId], references: [id])

  nilai Nilai[]
  raporPelengkap RaporPelengkap[]
}

model MataPelajaran {
  id        String   @id @default(uuid())
  kode      String   @unique // Contoh: "MAT", "IPA"
  nama      String   // Contoh: "Matematika"
  isMulok   Boolean  @default(false)
  isSeni    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nilai              Nilai[]
  pengampu           Pengampu[]
  tujuanPembelajaran TujuanPembelajaran[]
}

model Nilai {
  id         String   @id @default(uuid())
  tahunAjaran String  @default("2026/2027") // Contoh: "2026/2027"
  semester   Int      // 1 (Ganjil) atau 2 (Genap)
  nilaiTugas Float    @default(0)
  nilaiUTS   Float    @default(0)
  nilaiUAS   Float    @default(0)
  nilaiAkhir Float    @default(0)
  catatan    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  siswaId String
  siswa   Siswa  @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  mapelId String
  mapel   MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)

  @@unique([siswaId, mapelId, tahunAjaran, semester])
}

model Pengampu {
  id          String   @id @default(uuid())
  tahunAjaran String   // Contoh: "2026/2027"
  semester    Int      @default(0) // 0 = Berlaku Semester 1 & 2, 1 = Ganjil saja, 2 = Genap saja
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Guru pengampu
  guruId      String
  guru        User     @relation(fields: [guruId], references: [id], onDelete: Cascade)

  // Mata pelajaran yang diajar
  mapelId     String
  mapel       MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)

  // Kelas yang diajar
  kelasId     String
  kelas       Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([kelasId, mapelId, tahunAjaran, semester])
}

model TujuanPembelajaran {
  id          String   @id @default(uuid())
  kode        String   // Contoh: "TP 1", "TP 2"
  deskripsi   String   // Contoh: "menghitung operasi bilangan cacah sampai 100"
  tingkat     Int      // Tingkat kelas (1, 2, 3, 4, 5, 6)
  semester    Int      @default(1) // 1 (Ganjil) atau 2 (Genap)
  tahunAjaran String   // Contoh: "2026/2027"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi ke Mata Pelajaran
  mapelId     String
  mapel       MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)

  // Guru penyusun/pengampu
  guruId      String
  guru        User          @relation(fields: [guruId], references: [id], onDelete: Cascade)

  @@index([mapelId, tingkat, semester])
}

model PeriodeAkademik {
  id           String    @id @default(uuid())
  tahunAjaran  String    // Contoh: "2026/2027"
  semester     Int       // 1 (Ganjil) atau 2 (Genap)
  isAktif      Boolean   @default(false)
  statusNilai  String    @default("BUKA") // "BUKA" (Guru bisa edit) atau "KUNCI" (Read-only)
  tanggalCetak DateTime? // Tanggal cetak tanda tangan rapor
  tempatCetak  String?   @default("Jakarta")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sekolahId    String
  sekolah      Sekolah   @relation(fields: [sekolahId], references: [id], onDelete: Cascade)

  @@unique([sekolahId, tahunAjaran, semester])
  @@index([sekolahId, isAktif])
}

model RaporPelengkap {
  id                String   @id @default(uuid())
  tahunAjaran       String   // Contoh: "2026/2027"
  semester          Int      // 1 (Ganjil) atau 2 (Genap)
  sakit             Int      @default(0)
  izin              Int      @default(0)
  alpa              Int      @default(0)
  catatanWali       String?  // Narasi motivasi & evaluasi perkembangan karakter siswa
  ekskul            String?  // Format JSON array: [{ nama: "Pramuka", predikat: "Baik" }]
  kokurikuler       String?  // Format JSON array: [{ tema: "Tema 1: ...", deskripsi: "..." }]
  kebiasaanKarakter String?  // 7 Kebiasaan Anak Indonesia Hebat
  statusKenaikan    String?  // "LULUS" / "TIDAK LULUS" / "Naik ke Kelas X" / "Tinggal di Kelas X"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  siswaId           String
  siswa             Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tahunAjaran, semester])
  @@index([siswaId, tahunAjaran, semester])
}

model TemplateRapor {
  id          String   @id @default(uuid())
  kategori    String   // "TEMA_P5" | "KEBIASAAN" | "SARAN_WALI"
  judul       String?  // Contoh: "Tema 1: Kreasi Nusantara"
  teks        String   // Isi narasi/deskripsi template
  urutan      Int      @default(0)
  tahunAjaran String   // Contoh: "2025/2026"
  semester    Int      // 1 (Ganjil) atau 2 (Genap)

  kelasId     String
  kelas       Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kelasId, kategori, tahunAjaran, semester])
}